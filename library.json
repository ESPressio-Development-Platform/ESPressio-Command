        {"name": "ESPressio-Timing", "version": "https://github.com/ESPressio-Development-Platform/ESPressio-Timing.git#primitives_redesign"},
        {"name": "ESPressio-Serializable", "version": "https://github.com/ESPressio-Development-Platform/ESPressio-Serializable.git#primitives_redesign"},
