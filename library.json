{
    "name": "ESPressio-Command",
    "description": "Transport-neutral typed command definition, text/JSON interpretation, routing and invocation framework for ESP32 and C++17",
    "keywords": "command,commands,cli,json,console,parser,interpreter,router,dispatcher,observable,event,espressio",
    "authors": {
        "name": "Simon J. Stuart",
        "maintainer": true,
        "url": "https://espressio.org"
    },
    "homepage": "https://espressio.org",
    "build": {
        "flags": ["-std=gnu++17","-DESPRESSIO_COMMAND"]
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/ESPressio-Development-Platform/ESPressio-Command.git"
    },
    "version": "1.0.3",
    "license": "Apache-2.0",
    "frameworks": "*",
    "platforms": "*",
    "dependencies": [
        {
            "name": "ESPressio-Observable",
            "version": "https://github.com/ESPressio-Development-Platform/ESPressio-Observable.git#feature/16-rtti-free-observer-registry"
        },
        {
            "name": "ESPressio-Event",
            "version": "https://github.com/ESPressio-Development-Platform/ESPressio-Event.git#feature/57-rtti-free-memory-efficiency",
            "platforms": "espressif32"
        }
    ]
}
