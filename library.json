{
    "name": "ESPressio-Command",
    "description": "Transport-neutral typed command definition, text/JSON interpretation, routing and invocation framework for ESP32 and C++17",
    "keywords": "command,commands,cli,json,console,parser,interpreter,router,dispatcher,observable,event,espressio",
    "authors": {
        "name": "Simon J. Stuart",
        "maintainer": true,
        "url": "https://espressio.org"
    },
    "homepage": "https://espressio.org",
    "build": {
        "flags": [
            "-std=gnu++17",
            "-DESPRESSIO_COMMAND"
        ]
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/ESPressio-Development-Platform/ESPressio-Command.git"
    },
    "version": "1.0.0",
    "license": "Apache-2.0",
    "frameworks": "*",
    "platforms": "*",
    "dependencies": [
        {
            "name": "ESPressio-Observable",
            "version": ">=3.0.1 <4.0.0",
            "url": "https://github.com/ESPressio-Development-Platform/ESPressio-Observable.git"
        }
    ]
}
